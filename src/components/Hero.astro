---
import type { Person, Locales } from '../types'

export interface Props {
  person: Person
  lang: 'es' | 'en'
  locales: Locales
}

const { person, lang, locales } = Astro.props
---

<section id="hero" data-section="hero" class="hero-glow relative min-h-[80vh] flex items-center justify-center py-24 lg:py-32 overflow-hidden px-4 sm:px-6 lg:px-8">
  <!-- Dot grid background -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Decorative corner dots -->
  <div class="hero-corner hero-corner--tl" aria-hidden="true"></div>
  <div class="hero-corner hero-corner--tr" aria-hidden="true"></div>
  <div class="hero-corner hero-corner--bl" aria-hidden="true"></div>
  <div class="hero-corner hero-corner--br" aria-hidden="true"></div>

  <div class="text-center max-w-3xl mx-auto">
    <p class="animate-fade-in-up hero-greeting text-gold font-mono text-sm mb-4 tracking-widest uppercase" style="--delay: 0ms">
      {locales.hero.greeting.split('{{name}}')[0]}
    </p>
    <h1 class="animate-fade-in-up text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 text-dark-50" style="--delay: 120ms">
      {person.brandName}
    </h1>
    <p class="animate-fade-in-up text-lg sm:text-xl text-dark-200 mb-10 max-w-xl mx-auto leading-relaxed" style="--delay: 240ms">
      {person.tagline}
    </p>
    <div class="animate-fade-in-up flex flex-wrap items-center justify-center gap-4" style="--delay: 360ms">
      <a
        href={person.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-scale inline-flex items-center gap-2 px-6 py-3 border border-gold text-gold rounded-lg hover:bg-gold hover:text-dark transition-all duration-200 text-sm font-medium"
      >
        <!-- LinkedIn icon -->
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        {locales.hero.linkedin}
      </a>
      <a
        href={`mailto:${person.email}`}
        class="btn-scale inline-flex items-center gap-2 px-6 py-3 border border-dark-600 text-dark-200 rounded-lg hover:border-gold hover:text-gold transition-all duration-200 text-sm font-medium"
      >
        <!-- Email icon -->
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        {locales.hero.email}
      </a>
      <a
        href={`tel:+34${person.phone}`}
        class="btn-scale inline-flex items-center gap-2 px-6 py-3 border border-dark-600 text-dark-200 rounded-lg hover:border-gold hover:text-gold transition-all duration-200 text-sm font-medium"
      >
        <!-- Phone icon -->
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        {locales.hero.phone}
      </a>
    </div>
  </div>
</section>

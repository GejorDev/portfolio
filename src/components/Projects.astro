---
import type { Locales } from '../types'

export interface Props {
  projects: Project[]
  lang: 'es' | 'en'
  locales: Locales
}

const { projects, lang, locales } = Astro.props
---

<section id="projects" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto">
    <h2 class="heading-underline text-2xl sm:text-3xl font-bold text-dark-50 mb-8">
      {locales.projects.title}
    </h2>

    {
      projects.length === 0 ? (
        <div class="text-center py-28 glass rounded-lg">
          <svg class="w-16 h-16 mx-auto mb-4 text-dark-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
          <h3 class="text-xl font-semibold text-dark-50 mb-2">
            {locales.projects.empty.title}
          </h3>
          <p class="text-dark-200">
            {locales.projects.empty.description}
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            projects.map((project, index) => (
              <article key={project.key || index} data-stagger class="card-lift glass glass-hover rounded-lg p-6">
                <h3 class="text-lg font-semibold text-dark-50 mb-2">
                  {locales.projects.items[project.key]?.title ?? project.title}
                </h3>
                <p class="text-sm text-dark-200 mb-4 leading-relaxed">
                  {locales.projects.items[project.key]?.description ?? project.description}
                </p>
                {
                  project.tags && (
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag: string) => (
                        <span class="skill-badge">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )
                }
              </article>
            ))
          }
        </div>
      )
    }
  </div>
</section>
